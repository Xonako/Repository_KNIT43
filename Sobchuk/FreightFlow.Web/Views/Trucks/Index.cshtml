@model IReadOnlyList<IVehicle>
@{
    ViewData["Title"] = "Парк траків";
}

<h1 class="mb-4">Парк траків</h1>

<table class="table table-bordered bg-white">
    <thead>
        <tr>
            <th>Номер</th><th>Тип</th><th>Модель</th><th>Вантажопідйомність</th>
            <th>MPG</th><th>Пальне на 100 миль</th><th>Собівартість 100 миль</th><th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Id</td>
                <td>
                    @if (v is RefrigeratedTruck reefer)
                    {
                        <span>Рефрижератор (@reefer.Temperature °F)</span>
                    }
                    else
                    {
                        <span>Трак</span>
                    }
                </td>
                <td>@v.Model</td>
                <td>@v.MaxWeight lbs</td>
                <td>@(((Vehicle)v).FuelEconomy)</td>
                <td>@v.CalculateFuelNeeded(100) gal</td>
                <td>@Ui.Money(v.CalculateCost(100))</td>
                <td>
                    @if (v.IsAvailable)
                    {
                        <span class="badge bg-success">вільний</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">у рейсі</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="card mt-4">
    <div class="card-body">
        <h5>Додати трак</h5>
        <form asp-action="Add" method="post" class="row g-2">
            <div class="col-md-2">
                <input name="id" class="form-control" placeholder="Номер (T-103)" required />
            </div>
            <div class="col-md-2">
                <input name="model" class="form-control" placeholder="Модель" required />
            </div>
            <div class="col-md-2">
                <input name="maxWeight" type="number" step="any" min="1" class="form-control" placeholder="Вага, lbs" required />
            </div>
            <div class="col-md-2">
                <input name="fuelEconomy" type="number" step="any" min="1" class="form-control" placeholder="MPG" required />
            </div>
            <div class="col-md-2">
                <div class="form-check mt-2">
                    <input name="isRefrigerated" type="checkbox" value="true" class="form-check-input" id="isRef" />
                    <label class="form-check-label" for="isRef">Рефрижератор</label>
                </div>
            </div>
            <div class="col-md-2">
                <input name="fridgeFuelPerHour" type="number" step="any" min="0" value="0.8" class="form-control" title="Холодильник, gal/год" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Додати трак</button>
            </div>
        </form>
    </div>
</div>
