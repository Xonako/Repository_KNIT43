<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreightFlow</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">FreightFlow</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Головна</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Trucks" asp-action="Index">Парк траків</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Loads" asp-action="Index">Дошка вантажів</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Dispatch" asp-action="Index">Диспетчеризація</a></li>
            </ul>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @RenderBody()
    </main>
</body>
</html>
