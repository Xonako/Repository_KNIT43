<Window x:Class="FreightFlow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FreightFlow - система вантажоперевезень" Height="620" Width="1050"
        MinHeight="450" MinWidth="800" WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="0,6,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Скинути дані" Command="{Binding ResetCommand}" Margin="0"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl Margin="0,0,0,8">

            <TabItem Header="Головна" DataContext="{Binding Dashboard}">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Траків у парку" Foreground="Gray"/>
                                    <TextBlock Text="{Binding TruckCount}" FontSize="24"/>
                                    <TextBlock>
                                        <Run Text="вільних: "/><Run Text="{Binding FreeTrucks, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="На дошці" Foreground="Gray"/>
                                    <TextBlock Text="{Binding PostedCount}" FontSize="24"/>
                                    <TextBlock>
                                        <Run Text="заброньовано: "/><Run Text="{Binding BookedCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Доставлено" Foreground="Gray"/>
                                    <TextBlock Text="{Binding DeliveredCount}" FontSize="24"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="1" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Прибуток власника траків" Foreground="Gray"/>
                                    <TextBlock Text="{Binding CarrierProfit}" FontSize="24"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding BrokerInfo}" Margin="0,2"/>
                        <TextBlock Text="{Binding DispatcherInfo}" Margin="0,2"/>
                        <TextBlock Text="Звіт по виконаних рейсах" FontWeight="Bold" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Delivered}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" Width="*"/>
                            <DataGridTextColumn Header="Трак" Binding="{Binding Vehicle}"/>
                            <DataGridTextColumn Header="Ставка" Binding="{Binding CarrierRate}"/>
                            <DataGridTextColumn Header="Собівартість" Binding="{Binding Cost}"/>
                            <DataGridTextColumn Header="Брокеру" Binding="{Binding BrokerCommission}"/>
                            <DataGridTextColumn Header="Диспетчеру" Binding="{Binding DispatcherCommission}"/>
                            <DataGridTextColumn Header="Прибуток" Binding="{Binding Profit}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Парк траків" DataContext="{Binding Fleet}">
                <DockPanel Margin="10">
                    <GroupBox Header="Додати трак" DockPanel.Dock="Bottom">
                        <WrapPanel>
                            <StackPanel Width="110">
                                <TextBlock Text="Номер"/>
                                <TextBox Text="{Binding NewId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="130">
                                <TextBlock Text="Модель"/>
                                <TextBox Text="{Binding NewModel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="110">
                                <TextBlock Text="Вага, lbs"/>
                                <TextBox Text="{Binding NewMaxWeight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="110">
                                <TextBlock Text="MPG"/>
                                <TextBox Text="{Binding NewFuel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <CheckBox Content="Рефрижератор" IsChecked="{Binding NewIsRefrigerated}"
                                      VerticalAlignment="Bottom" Margin="0,0,10,6"/>
                            <StackPanel Width="130" IsEnabled="{Binding NewIsRefrigerated}">
                                <TextBlock Text="Холодильник, gal/год"/>
                                <TextBox Text="{Binding NewFridgeFuel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Content="Додати трак" Command="{Binding AddTruckCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>

                    <DataGrid ItemsSource="{Binding Vehicles}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                            <DataGridTextColumn Header="Вантажопідйомність" Binding="{Binding MaxWeight}"/>
                            <DataGridTextColumn Header="MPG" Binding="{Binding Mpg}"/>
                            <DataGridTextColumn Header="Пальне на 100 миль" Binding="{Binding Fuel100}"/>
                            <DataGridTextColumn Header="Собівартість 100 миль" Binding="{Binding Cost100}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Дошка вантажів" DataContext="{Binding LoadBoard}">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}"
                                  Width="160" Margin="0,0,15,0"/>
                        <TextBlock Text="Мін. ставка, $/милю:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding MinRateText, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </StackPanel>

                    <GroupBox Header="Викласти вантаж (брокер)" DockPanel.Dock="Bottom">
                        <WrapPanel>
                            <StackPanel Width="120">
                                <TextBlock Text="Звідки"/>
                                <TextBox Text="{Binding NewFrom, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="120">
                                <TextBlock Text="Куди"/>
                                <TextBox Text="{Binding NewTo, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="90">
                                <TextBlock Text="Милі"/>
                                <TextBox Text="{Binding NewDistance, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="90">
                                <TextBlock Text="Вага, lbs"/>
                                <TextBox Text="{Binding NewWeight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Width="150">
                                <TextBlock Text="Тип"/>
                                <ComboBox ItemsSource="{Binding CargoOptions}" SelectedIndex="{Binding NewTypeIndex}"
                                          Margin="0,2,10,0"/>
                            </StackPanel>
                            <StackPanel Width="110">
                                <TextBlock Text="Ціна, $"/>
                                <TextBox Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Content="Викласти" Command="{Binding PostLoadCommand}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </GroupBox>

                    <DataGrid ItemsSource="{Binding Loads}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Звідки" Binding="{Binding From}" Width="*"/>
                            <DataGridTextColumn Header="Куди" Binding="{Binding To}" Width="*"/>
                            <DataGridTextColumn Header="Відстань" Binding="{Binding Distance}"/>
                            <DataGridTextColumn Header="Вага" Binding="{Binding Weight}"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Платить відправник" Binding="{Binding ShipperPrice}"/>
                            <DataGridTextColumn Header="Ставка перевізнику" Binding="{Binding CarrierRate}"/>
                            <DataGridTextColumn Header="$/миля" Binding="{Binding RatePerMile}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Диспетчеризація" DataContext="{Binding Dispatch}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Вільні вантажі" Margin="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                                    Content="Забронювати вибраний" Command="{Binding BookCommand}"/>
                            <DataGrid ItemsSource="{Binding AvailableLoads}" SelectedItem="{Binding SelectedAvailable}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" Width="*"/>
                                    <DataGridTextColumn Header="Відстань" Binding="{Binding Distance}"/>
                                    <DataGridTextColumn Header="Вага" Binding="{Binding Weight}"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}"/>
                                    <DataGridTextColumn Header="Ставка" Binding="{Binding CarrierRate}"/>
                                    <DataGridTextColumn Header="Найкращий трак" Binding="{Binding Vehicle}"/>
                                    <DataGridTextColumn Header="Собівартість" Binding="{Binding Cost}"/>
                                    <DataGridTextColumn Header="Потрібна ставка" Binding="{Binding RequiredRate}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Заброньовані">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                                    Content="Позначити доставленим" Command="{Binding DeliverCommand}"/>
                            <DataGrid ItemsSource="{Binding BookedLoads}" SelectedItem="{Binding SelectedBooked}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" Width="*"/>
                                    <DataGridTextColumn Header="Трак" Binding="{Binding Vehicle}"/>
                                    <DataGridTextColumn Header="Пальне" Binding="{Binding Fuel}"/>
                                    <DataGridTextColumn Header="Час у дорозі" Binding="{Binding Time}"/>
                                    <DataGridTextColumn Header="Ставка" Binding="{Binding CarrierRate}"/>
                                    <DataGridTextColumn Header="Собівартість" Binding="{Binding Cost}"/>
                                    <DataGridTextColumn Header="Прибуток" Binding="{Binding Profit}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
